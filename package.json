{
  "name": "mcp-server-demo",
  "version": "1.0.0",
  "description": "MCP server with current time and Programación y Más course recommendations",
  "type": "module",
  "bin": {
    "mcp-server-demo": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && mkdir -p build/data && cp src/data/courses.json build/data/courses.json && chmod 755 build/index.js",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
